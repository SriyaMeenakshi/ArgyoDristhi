<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STEP 3 OF 4 — ON-DEVICE AI INFERENCE"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.08"
        android:layout_marginBottom="16dp" />

    <!-- Current step label -->
    <TextView
        android:id="@+id/tvStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading AI model…"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- Overall progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progressDrawable="@drawable/progress_teal"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="24dp" />

    <!-- CROSS-MODAL ATTENTION FUSION section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CROSS-MODAL ATTENTION FUSION"
        android:textSize="10sp"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Face encoder row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                android:text="Face encoder (MobileViT-S)" android:textSize="12sp"
                android:textColor="@color/text_primary" />
            <ProgressBar android:id="@+id/pbFace"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="6dp"
                android:layout_weight="1" android:progressDrawable="@drawable/progress_teal"
                android:max="100" android:progress="0" android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Eye encoder row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                android:text="Eye encoder (CNN)" android:textSize="12sp"
                android:textColor="@color/text_primary" />
            <ProgressBar android:id="@+id/pbEye"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="6dp"
                android:layout_weight="1" android:progressDrawable="@drawable/progress_teal"
                android:max="100" android:progress="0" android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Tongue encoder row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                android:text="Tongue encoder (ResNet34)" android:textSize="12sp"
                android:textColor="@color/text_primary" />
            <ProgressBar android:id="@+id/pbTongue"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="6dp"
                android:layout_weight="1" android:progressDrawable="@drawable/progress_teal"
                android:max="100" android:progress="0" android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Skin encoder row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                android:text="Skin encoder (ViT)" android:textSize="12sp"
                android:textColor="@color/text_primary" />
            <ProgressBar android:id="@+id/pbSkin"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="6dp"
                android:layout_weight="1" android:progressDrawable="@drawable/progress_teal"
                android:max="100" android:progress="0" android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Nail/Palm encoder row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                android:text="Nail/palm encoder" android:textSize="12sp"
                android:textColor="@color/text_primary" />
            <ProgressBar android:id="@+id/pbNailPalm"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="6dp"
                android:layout_weight="1" android:progressDrawable="@drawable/progress_teal"
                android:max="100" android:progress="0" android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Fusion row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                android:text="Cross-modal fusion" android:textSize="12sp"
                android:textColor="@color/text_primary" />
            <ProgressBar android:id="@+id/pbFusion"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="6dp"
                android:layout_weight="1" android:progressDrawable="@drawable/progress_teal"
                android:max="100" android:progress="0" android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
