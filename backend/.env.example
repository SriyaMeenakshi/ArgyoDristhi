# ── Firebase ──────────────────────────────────────────────────────────────────
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=arogyadrishti
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@arogyadrishti.iam.gserviceaccount.com

# ── Twilio ────────────────────────────────────────────────────────────────────
# From: twilio.com → Console Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# WhatsApp sandbox number (from Twilio Console → Messaging → WhatsApp → Sandbox)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Twilio SMS number (from Twilio Console → Phone Numbers)
TWILIO_SMS_FROM=+1415XXXXXXX

# ── ABDM Sandbox ──────────────────────────────────────────────────────────────
# From: sandbox.abdm.gov.in → Register → API Credentials
ABDM_BASE_URL=https://sandbox.abdm.gov.in/api/v3
ABDM_CLIENT_ID=your_client_id
ABDM_CLIENT_SECRET=your_client_secret

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# PHC Doctor WhatsApp (default fallback — override per-patient via Firestore doctors collection)
DEFAULT_PHC_WHATSAPP=whatsapp:+91XXXXXXXXXX
DEFAULT_PHC_NAME=Dr. PHC Doctor
